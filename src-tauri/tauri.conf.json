{
  "$schema": "https://schema.tauri.app/config",
  "productName": "Era XVlan Mesh",
  "mainBinaryName": "EraXVlanMesh",
  "identifier": "com.era.xvlan.mesh",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/Square30x30Logo.png",
      "icons/Square44x44Logo.png",
      "icons/Square71x71Logo.png",
      "icons/Square89x89Logo.png",
      "icons/Square107x107Logo.png",
      "icons/Square142x142Logo.png",
      "icons/Square150x150Logo.png",
      "icons/Square284x284Logo.png",
      "icons/Square310x310Logo.png",
      "icons/StoreLogo.png"
    ],
    "publisher": "Era XVlan Team. <<x@era-x.cn>>",
    "copyright": "Copyright © 2022-present Era XVlan Team. All rights reserved.",
    "createUpdaterArtifacts": false
  },
  "plugins": {},
  "app": {
    "windows": [
      {
        "title": "Era XVlan Mesh",
        "width": 685,
        "height": 400,
        "minHeight": 320,
        "minWidth": 685,
        "maximizable": false
      }
    ],
    "security": {
      "csp": null
    }
  }
}
